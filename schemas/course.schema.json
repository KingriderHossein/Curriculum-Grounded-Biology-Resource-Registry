{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/course.schema.json",
  "title": "Course Registry",
  "type": "object",
  "required": ["schema_version", "courses"],
  "properties": {
    "schema_version": {"type": "string"},
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fa_name", "en_name", "degree", "field", "authority", "delivery", "topics"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fa_name": {"type": "string"},
          "en_name": {"type": "string"},
          "degree": {"type": "string"},
          "field": {"type": "string"},
          "authority": {"type": "string"},
          "delivery": {"const": "theoretical"},
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": {"type": "string"},
                "label": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
