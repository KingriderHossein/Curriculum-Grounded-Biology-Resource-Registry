{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/resource.schema.json",
  "title": "Global Resource Registry",
  "type": "object",
  "required": [
    "schema_version",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "resource_type",
          "theory_only",
          "title",
          "published_year",
          "publisher_url",
          "verification_status",
          "verified_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "resource_type": {
            "enum": [
              "textbook",
              "review_article",
              "open_academic_resource",
              "book_chapter",
              "authoritative_reference"
            ]
          },
          "theory_only": {
            "const": true
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "edition": {
            "type": "string"
          },
          "published_year": {
            "type": "integer"
          },
          "publisher": {
            "type": "string"
          },
          "journal": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "publisher_url": {
            "type": "string"
          },
          "purchase_url": {
            "type": "string"
          },
          "access_url": {
            "type": "string"
          },
          "cover": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "verification_status": {
            "enum": [
              "candidate",
              "verified",
              "provisional",
              "outdated"
            ]
          },
          "verified_on": {
            "type": "string"
          }
        }
      }
    }
  }
}
