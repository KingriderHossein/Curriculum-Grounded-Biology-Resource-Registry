{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/subject.schema.json",
  "title": "Subject Registry",
  "type": "object",
  "required": [
    "schema_version",
    "subjects"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fa_name",
          "en_name",
          "scope",
          "roadmap_stages",
          "concepts",
          "branches"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "const": "theoretical"
          },
          "roadmap_stages": {
            "type": "array",
            "items": {
              "enum": [
                "foundation",
                "core",
                "intermediate",
                "advanced",
                "specialized"
              ]
            }
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "enum": [
              "in_progress",
              "complete_candidate",
              "complete"
            ]
          },
          "completed_on": {
            "type": "string"
          },
          "completion_criteria": {
            "type": "object",
            "properties": {
              "general_roadmap_resources": {
                "type": "integer",
                "minimum": 1
              },
              "specialized_branches_required": {
                "type": "integer",
                "minimum": 0
              },
              "student_guidance_required": {
                "type": "boolean"
              },
              "theory_only": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
